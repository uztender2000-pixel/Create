# Render will provide this automatically if you use their managed PostgreSQL —
# copy the "Internal Database URL" it gives you into this variable.
DATABASE_URL=postgres://user:password@host:5432/dbname

PORT=3000

# ---------------------------------------------------------------------
# ПОСТАЧАЛЬНИКИ
#
# Постачальники більше не налаштовуються через .env — вони живуть у базі
# (таблиця suppliers) і керуються через /api/admin/suppliers. Так можна
# додати нового постачальника без редеплою.
#
# Змінні FEED_1_URL..FEED_5_URL залишені ЛИШЕ для сумісності: при першому
# старті, якщо dropshipping.ua ще не має фідів у базі, вони перенесуться
# туди автоматично. Після цього база — джерело правди, а ці змінні
# ігноруються, і їх можна видалити.
# ---------------------------------------------------------------------
FEED_1_URL=https://api.dropshipping.ua/api/feeds/5025.xml
FEED_2_URL=https://api.dropshipping.ua/api/feeds/5026.xml
FEED_3_URL=https://api.dropshipping.ua/api/feeds/5036.xml
FEED_4_URL=
FEED_5_URL=

# Те саме для API замовлень: підхопиться в постачальника dropshipping_ua
# при першому старті, далі керується через адмін-API.
SUPPLIER_API_URL=
SUPPLIER_API_KEY=

# Як часто синхронізувати каталоги ВСІХ активних постачальників.
# Default: щогодини. Для великих каталогів (BRAIN, MTI — десятки тисяч
# SKU) розумніше '0 */3 * * *' і окремий частіший синк залишків.
FEED_SYNC_CRON=0 * * * *

# Telegram bot for new-order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret used to sign customer login tokens. Any long random string.
JWT_SECRET=

# Owner dashboard — MUST be a different random string than JWT_SECRET.
ADMIN_JWT_SECRET=

# First-boot only: creates your owner account if admin_users is empty.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Nova Poshta API key — free, from https://new.novaposhta.ua →
# Особистий кабінет → Налаштування → API ключі.
NOVA_POSHTA_API_KEY=

# SMS-провайдер для підтвердження телефону — AlphaSMS (alphasms.ua)
# SMS_API_KEY — API-ключ з особистого кабінету AlphaSMS.
# SMS_SENDER  — ім'я відправника (альфа-ім'я), доступне у вашому кабінеті
#               (латиниця/цифри, до 11 символів, точно так, як у кабінеті).
SMS_API_KEY=
SMS_SENDER=
# Необов'язково. За замовчуванням: https://alphasms.ua/api/json.php
SMS_API_URL=

# Листи (підтвердження email, скидання пароля) через SendPulse API — основний спосіб.
# Ключ: SendPulse → Налаштування → API → API-ключі → Згенерувати.
# Вказуйте лише заповнювачі в цьому файлі; справжні значення — у змінних середовища Render.
SENDPULSE_API_KEY=your-sendpulse-api-key
# Тестовий тариф: devtest@sendpulseemail.com (діє одразу, але лише поки ви не підтвердили власного відправника).
# Після підтвердження свого домену/відправника замініть на нього — інакше буде HTTP 422 «Відправник недійсний».
SENDPULSE_API_FROM_EMAIL=devtest@sendpulseemail.com
SENDPULSE_API_FROM_NAME=В Хату.UA
# Необов'язково (за замовчуванням https://api.sendpulse.com)
SENDPULSE_API_BASE_URL=

# Назва магазину в листах і SMS (за замовчуванням «В Хату.UA»)
SHOP_NAME=В Хату.UA

# ШІ-помічник на сайті (Claude). Ключ: console.anthropic.com → API Keys (потрібен окремий платіж за API, підписка claude.ai не підходить).
# Без ключа помічник вимкнений і віджет на сайті не показується.
ANTHROPIC_API_KEY=
# Необов'язково: модель (за замовчуванням claude-sonnet-5-5), денний ліміт запитів (300), додаткові відомості про магазин для помічника
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=300
ASSISTANT_SHOP_NOTES=

# SMTP — запасний варіант: використовується, лише якщо SendPulse не налаштовано
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Посилання на Telegram-бота для клієнтів (показується в кабінеті)
TELEGRAM_CUSTOMER_BOT_URL=

# Домен фронтенду — обмежує, хто може звертатись до API з браузера.
FRONTEND_ORIGIN=
