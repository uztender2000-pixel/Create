# Render will provide this automatically if you use their managed PostgreSQL —
# copy the "Internal Database URL" it gives you into this variable.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port Render expects your app to listen on (Render sets this itself in production,
# this is just a local-dev fallback).
PORT=3000

# Up to 5 feed URLs from dropshipping.ua. Just the URLs — the site figures
# out sections and categories on its own from each feed's category tree,
# no manual labeling needed. Leave unused ones blank/omit.
FEED_1_URL=https://api.dropshipping.ua/api/feeds/5025.xml
FEED_2_URL=https://api.dropshipping.ua/api/feeds/5026.xml
FEED_3_URL=https://api.dropshipping.ua/api/feeds/5036.xml
FEED_4_URL=
FEED_5_URL=

# How often to re-pull the feeds, in cron syntax. Default: every hour.
FEED_SYNC_CRON=0 * * * *

# Telegram bot for new-order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret used to sign login tokens. Set this to any long random string —
# e.g. generate one at https://www.uuidgenerator.net/ or just mash the
# keyboard for 40+ characters. Keep it secret; changing it logs everyone out.
JWT_SECRET=
