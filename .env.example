# Render will provide this automatically if you use their managed PostgreSQL —
# copy the "Internal Database URL" it gives you into this variable.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port Render expects your app to listen on (Render sets this itself in production,
# this is just a local-dev fallback).
PORT=3000

# Your personal product feed URLs from dropshipping.ua
FEED_URL_ZOOTOVARY=https://api.dropshipping.ua/api/feeds/5025.xml
FEED_URL_AMUNITSIYA=https://api.dropshipping.ua/api/feeds/5026.xml

# How often to re-pull the feed, in cron syntax. Default: every hour.
FEED_SYNC_CRON=0 * * * *

# Optional: Telegram bot for new-order notifications (set up later, can leave blank for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
